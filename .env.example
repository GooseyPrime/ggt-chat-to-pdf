# Shop origin that owns Stripe (no secrets / no Stripe SDK in this repo).
NEXT_PUBLIC_SHOP_ORIGIN=https://goldengoosetools.com

# Optional subpath when mounted under the shop.
# NEXT_PUBLIC_BASE_PATH=/tools/chat-to-pdf

# Comma list of sale products the shop desk currently accepts.
# After GoldenGooseTools#40: include chat-to-pdf when the desk allowlist is live.
# Until "chat-to-pdf" appears here, checkout is refused (never fall through).
NEXT_PUBLIC_SHOP_SALE_PRODUCTS=seo-audit,accessibility,fix-it,a11y-statement,quote-invoice,chat-to-pdf

# Single SKU price in cents, mirrored from shop config (CHAT_TO_PDF_PRICE_CENTS = 500).
# Leave unset to hide the dollar figure — never invent a runtime fallback.
# NEXT_PUBLIC_PRICE_CENTS=500

# Local unlock only — never enable in production.
# NEXT_PUBLIC_ALLOW_LOCAL_UNLOCK=true
