# Shop origin that owns Stripe (no secrets / no Stripe SDK in this repo).
NEXT_PUBLIC_SHOP_ORIGIN=https://www.goldengoosetools.com

# Defaults to /tools/chat-to-pdf (served inside the shop). Set to an empty string
# for a standalone root deploy.
# NEXT_PUBLIC_BASE_PATH=

# Comma list of sale products the shop desk accepts (defaults to all ten shop SKUs).
# If this omits chat-to-pdf, checkout is refused (never falls through to another price).
# NEXT_PUBLIC_SHOP_SALE_PRODUCTS=seo-audit,accessibility,chat-to-pdf

# Single SKU price in cents, mirrored from shop config (CHAT_TO_PDF_PRICE_CENTS = 500).
# Leave unset to hide the dollar figure — never invent a runtime fallback.
NEXT_PUBLIC_PRICE_CENTS=500

# Local unlock only — ignored in production builds.
# NEXT_PUBLIC_ALLOW_LOCAL_UNLOCK=true
