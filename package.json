{
  "name": "ggt-chat-to-pdf",
  "version": "0.2.0",
  "private": true,
  "description": "Golden Goose Tools — Chat to PDF. A browser extension (Chrome/Edge/Firefox) that exports ChatGPT, Gemini, Copilot and Claude conversations to nicely formatted PDFs, processed locally. Free tier is watermarked; the clean tier unlocks via the shop checkout. This repo also serves the /tools/chat-to-pdf install page.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:extension": "node scripts/build-extension.mjs",
    "prebuild": "node scripts/build-extension.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "ggt-design-kit": "github:GooseyPrime/ggt-design-kit#f69b388c00bfa8872a951aa683c51c14f8933ef8",
    "jspdf": "^4.2.1",
    "next": "^16.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
